{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "source-artifacts-bootstrap",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "source-bootstrap" }],
  "observability": { "enabled": false }
}
