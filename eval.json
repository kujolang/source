{
  "name": "source-release-gate",
  "description": "Deterministic release checks for the agent-facing Source service.",
  "version": "1.0.0",
  "output_dir": ".eval_results",
  "stop_on_failure": false,
  "tests": [
    {
      "name": "JavaScript syntax lint",
      "check": "command_succeeds",
      "params": { "command": "env PATH=\"${PATH:-}:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin\" npm run lint" }
    },
    {
      "name": "Formatting hygiene",
      "check": "command_succeeds",
      "params": { "command": "env PATH=\"${PATH:-}:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin\" npm run format:check" }
    },
    {
      "name": "Node test suite",
      "check": "command_succeeds",
      "params": { "command": "env PATH=\"${PATH:-}:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin\" npm test" },
      "timeout_seconds": 300
    },
    {
      "name": "Concurrency regression suite",
      "check": "command_succeeds",
      "params": { "command": "env PATH=\"${PATH:-}:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin\" npm run test:scale" },
      "timeout_seconds": 120
    },
    {
      "name": "CLI help remains available",
      "check": "command_succeeds",
      "params": { "command": "env PATH=\"${PATH:-}:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin\" node bin/source.js help" }
    },
    {
      "name": "Working tree diff is whitespace-clean",
      "check": "command_succeeds",
      "params": { "command": "git diff --check" }
    },
    {
      "name": "Production dependency audit is clean",
      "check": "command_succeeds",
      "params": { "command": "env PATH=\"${PATH:-}:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin\" npm audit --omit=dev --audit-level=high" },
      "timeout_seconds": 120
    },
    {
      "name": "Kujo environment doctor passes without failures",
      "check": "command_succeeds",
      "params": { "command": "kujo doctor --deep --json" },
      "timeout_seconds": 120
    }
  ]
}
