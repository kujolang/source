{
  "name": "source",
  "version": "0.1.0",
  "description": "Source \u2014 agent-first software-development and collaboration platform built around Git",
  "type": "module",
  "private": true,
  "bin": {
    "source": "./bin/source.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:scale": "node --test tests/concurrency.test.js",
    "test:postgres": "node --test --test-concurrency=1 tests/postgres-claims-live.test.js tests/postgres-live.test.js tests/postgres-regressions.test.js tests/store.test.js",
    "test:container": "bash scripts/container-cluster-smoke.sh",
    "test:worker": "node --test tests/worker.test.js",
    "lint": "node scripts/lint.js",
    "format:check": "git diff --check",
    "load": "node scripts/load.js",
    "backup": "node scripts/backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "backup:restore-drill": "node scripts/restore-drill.js",
    "replicate:git": "node scripts/replicate-git.js",
    "replicate:postgres": "node scripts/replicate-postgres.js",
    "drill:failover": "node scripts/failover-drill.js",
    "check:postgres-replication": "node scripts/check-postgres-replication.js",
    "demo:contest": "node scripts/contest/demo.js",
    "demo:serve": "node scripts/contest/serve.js",
    "test:cloudflare": "npm --prefix cloudflare/artifacts-bootstrap test",
    "demo:hybrid": "node scripts/contest/hybrid.js",
    "demo:cloudflare": "node scripts/contest/demo.js --live-cloudflare --trace"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "pg": "^8.23.0"
  }
}
