{
  "name": "source",
  "version": "0.1.0",
  "description": "Source — agent-first software-development and collaboration platform built around Git",
  "type": "module",
  "private": true,
  "bin": {
    "source": "./bin/source.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:scale": "node --test tests/concurrency.test.js",
    "test:postgres": "node --test tests/postgres-live.test.js",
    "test:container": "bash scripts/container-cluster-smoke.sh",
    "test:worker": "node --test tests/worker.test.js",
    "lint": "node scripts/lint.js",
    "format:check": "git diff --check",
    "load": "node scripts/load.js",
    "backup": "node scripts/backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "backup:restore-drill": "node scripts/restore-drill.js",
    "replicate:git": "node scripts/replicate-git.js",
    "replicate:postgres": "node scripts/replicate-postgres.js",
    "drill:failover": "node scripts/failover-drill.js",
    "check:postgres-replication": "node scripts/check-postgres-replication.js"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "dependencies": {
    "js-yaml": "^4.3.1",
    "pg": "^8.23.0"
  }
}
